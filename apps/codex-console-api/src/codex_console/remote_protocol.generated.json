    "EnvironmentStatusParams": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "definitions": {},
      "description": "Parameters for reading the current status of one configured environment.",
      "properties": {
        "environmentId": {
          "description": "Environment id to inspect.",
          "type": "string"
        }
      },
      "required": [
