# Independent console settings. Do not use the miy application database.
MIY_CODEX_CONSOLE_DATABASE_URL=sqlite+pysqlite:////absolute/path/to/console-data/console.sqlite3
MIY_CODEX_CONSOLE_ORIGIN=https://codex.example.com
# Empty for a dedicated host, /codex-console behind the miy HTTPS proxy.
MIY_CODEX_CONSOLE_BASE_PATH=
MIY_CODEX_CONSOLE_WORKSPACE=/absolute/path/to/repository
MIY_CODEX_CONSOLE_BINARY=codex
# Ordered from lowest to highest; unknown efforts stay unavailable until explicitly allowed.
MIY_CODEX_CONSOLE_ALLOWED_REASONING_EFFORTS=["none","minimal","low","medium","high","xhigh"]
MIY_CODEX_CONSOLE_BIND_HOST=127.0.0.1
MIY_CODEX_CONSOLE_PORT=19365
# Independent UI/auth/monitoring process; session API keeps its own port.
MIY_CODEX_CONSOLE_MANAGEMENT_PORT=19367
# Dedicated template executor with a separately installed, tested Codex binary.
MIY_CODEX_CONSOLE_TEMPLATE_PORT=19368
MIY_CODEX_CONSOLE_TEMPLATE_BINARY=/absolute/path/to/pinned-codex/codex
MIY_CODEX_CONSOLE_MAX_ACTIVE_TASKS=3
# Owner-configured private IP health URLs and/or exact systemd unit / container names.
# No runtime commands, credentials, query strings, redirects, or hostname resolution.
MIY_CODEX_CONSOLE_MONITOR_SERVICES=[]
MIY_CODEX_CONSOLE_WEB_DIST=../codex-console-web/dist
MIY_CODEX_CONSOLE_SESSION_HOURS=12
# JSON object mapping trusted miy backends to their console owner UUID.
# With one backend, its browser address aliases all use that backend's code exchange.
MIY_CODEX_CONSOLE_SSO_SUBJECTS={}
# Optional MIY app catalog/usage read integration. Issue a dedicated platform API key
# with app-catalog:read and app-usage:read. Both origin and key must be configured together.
MIY_CODEX_CONSOLE_MIY_API_ORIGIN=
MIY_CODEX_CONSOLE_MIY_API_KEY=
# Optional development UI origin; previews open a separate authenticated tab.
MIY_CODEX_CONSOLE_PREVIEW_ORIGIN=
# Disposable read-only copies; originals are backed up with the dedicated SQLite DB.
MIY_CODEX_CONSOLE_ATTACHMENT_CACHE=~/.local/share/miy-codex-console/attachments
MIY_CODEX_CONSOLE_ATTACHMENT_MAX_BYTES=52428800
MIY_CODEX_CONSOLE_ATTACHMENT_TASK_MAX_BYTES=524288000
# Dirty checkouts are isolated from this ref into this external directory.
MIY_CODEX_CONSOLE_WORKTREE_BASE_REF=HEAD
MIY_CODEX_CONSOLE_WORKTREE_ROOT=~/.local/share/miy-codex-console/worktrees
# JSON array. Configure deployment-specific production roots.
MIY_CODEX_CONSOLE_PROTECTED_WORKSPACES=[]
