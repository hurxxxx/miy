# Independent console settings. Do not use the MTY application database.
MTY_CODEX_CONSOLE_DATABASE_URL=postgresql+psycopg://console:CHANGE_ME@127.0.0.1:5432/codex_console
MTY_CODEX_CONSOLE_ORIGIN=https://codex.example.com
# Empty for a dedicated host, /codex-console behind the MTY HTTPS proxy.
MTY_CODEX_CONSOLE_BASE_PATH=
MTY_CODEX_CONSOLE_WORKSPACE=/absolute/path/to/repository
MTY_CODEX_CONSOLE_BINARY=codex
# Ordered from lowest to highest; unknown efforts stay unavailable until explicitly allowed.
MTY_CODEX_CONSOLE_ALLOWED_REASONING_EFFORTS=["none","minimal","low","medium","high","xhigh"]
MTY_CODEX_CONSOLE_BIND_HOST=127.0.0.1
MTY_CODEX_CONSOLE_PORT=19365
# Independent UI/auth/monitoring process; session API keeps its own port.
MTY_CODEX_CONSOLE_MANAGEMENT_PORT=19367
MTY_CODEX_CONSOLE_MAX_ACTIVE_TASKS=3
# Owner-configured private IP health URLs and/or exact systemd unit / container names.
# No runtime commands, credentials, query strings, redirects, or hostname resolution.
MTY_CODEX_CONSOLE_MONITOR_SERVICES=[]
MTY_CODEX_CONSOLE_WEB_DIST=../codex-console-web/dist
MTY_CODEX_CONSOLE_SESSION_HOURS=12
# JSON object mapping each exact MTY origin to the sole owner user UUID.
MTY_CODEX_CONSOLE_SSO_SUBJECTS={}
# Disposable read-only copies; originals are backed up with the dedicated PostgreSQL DB.
MTY_CODEX_CONSOLE_ATTACHMENT_CACHE=~/.local/share/mty-codex-console/attachments
MTY_CODEX_CONSOLE_ATTACHMENT_MAX_BYTES=52428800
MTY_CODEX_CONSOLE_ATTACHMENT_TASK_MAX_BYTES=524288000
# Dirty checkouts are isolated from this ref into this external directory.
MTY_CODEX_CONSOLE_WORKTREE_BASE_REF=HEAD
MTY_CODEX_CONSOLE_WORKTREE_ROOT=~/.local/share/mty-codex-console/worktrees
# JSON arrays. Configure deployment-specific production roots and application DB names.
MTY_CODEX_CONSOLE_PROTECTED_WORKSPACES=[]
MTY_CODEX_CONSOLE_FORBIDDEN_DATABASE_NAMES=[]
