[importlinter]
root_package = miy_api

[importlinter:contract:routers_are_composition_only]
name = Router modules are imported only by the API composition registry
type = protected
protected_modules =
    miy_api.domains.*.router
    miy_api.domains.auth.apps_router
allowed_importers =
    miy_api.api_registry
    miy_api.platform_api_registry
    miy_api.official_api_registry
    miy_api.installed_extension_apps
as_packages = false

[importlinter:contract:domains_do_not_import_composition_roots]
name = Domain modules do not import API composition roots
type = forbidden
source_modules =
    miy_api.domains
forbidden_modules =
    miy_api.app
    miy_api.main
    miy_api.api_registry
    miy_api.platform_api_registry
    miy_api.official_api_registry
    miy_api.platform_main
    miy_api.official_auth
