{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "vitest"],
    "rootDir": "../..",
    "paths": {
      "@miy/contracts": ["../../packages/contracts/src/index.ts"],
      "@miy/contracts/openapi": [
        "../../packages/contracts/src/openapi.generated.d.ts"
      ],
      "@miy/contracts/*": ["../../packages/contracts/src/*"],
      "@miy/core-web": ["../../packages/core-web/src/index.ts"],
      "@miy/core-web/*": ["../../packages/core-web/src/*"],
      "@miy/web-shell": ["./src/app/shell/AppContent.tsx"],
      "@miy/web-official-suite-bridge": ["./src/official-suite-bridge.ts"],
      "@miy/ui": ["../../packages/ui/src/index.ts"],
      "@miy/ui/*": ["../../packages/ui/src/lib/*"],
      "@miy/ui/styles.css": ["../../packages/ui/styles.css"],
      "@/src/*": ["./src/*"],
      "@miy/official-suite-web": [
        "../../packages/official-suite-web/src/index.ts"
      ],
      "@miy/official-suite-web/*": ["../../packages/official-suite-web/src/*"],
      "@miy/platform-web": ["../../packages/platform-web/src/index.ts"],
      "@miy/platform-web/*": ["../../packages/platform-web/src/*"]
    }
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./tsconfig.e2e.json"
    }
  ],
  "extends": "../../tsconfig.base.json"
}
