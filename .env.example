# miy environment
# Secrets, installation identity and site overrides. Never commit a real .env.
# Public tuning defaults live in config/runtime.json; omit them here unless overriding.
# Values may differ by environment; do not print secrets in logs.

# Runtime identity, API entrypoint, and web development
MIY_API_ALLOW_DEV_ADMIN_LOGIN=1
MIY_API_APP_NAME=miy API
MIY_API_DEV_LOGIN_ALLOWED_HOSTS=
MIY_API_DEV_LOGIN_PASSWORD=miy-dev-only
MIY_API_DEV_PORT=8001
MIY_API_ENVIRONMENT=development
MIY_API_FRONTEND_DIST_DIR=
MIY_API_INSTANCE_ID=dev-api
MIY_API_OBJECT_STORAGE_REQUIRED=true
MIY_API_PREFIX=/api/v1
MIY_API_SEED_DEV_LOGIN_ACCOUNT=true
MIY_API_SERVE_FRONTEND=false
# Exact browser origins of this platform (JSON array); independent app sessions fail
# closed until configured. Include the portal origin when API and web are separated.
MIY_INDEPENDENT_APP_PLATFORM_ORIGINS=[]
# Optional core-owned app/install/source/image bindings; empty disables the consumer.
MIY_INDEPENDENT_APP_DELIVERY_TARGETS=[]
# Optional core-only dedicated app data cluster. Never copy into app environments.
MIY_INDEPENDENT_APP_DATA_POSTGRES_DSN=
MIY_INDEPENDENT_APP_DATA_CREDENTIAL_KEY=
# Optional selected-file reads; empty disables the feature in every environment.
MIY_INDEPENDENT_APP_FILE_SELECTION_SIGNING_KEY=
MIY_INDEPENDENT_APP_FILE_SELECTION_STORAGE_REGION=us-east-1
MIY_API_SESSION_TTL_HOURS=168
MIY_ENV_PROFILE=dev
MIY_WEB_API_PROXY_TARGET=http://127.0.0.1:8001
MIY_WEB_DEV_ALLOWED_HOSTS=
MIY_UAT_BASE_URL=
MIY_WEB_DEV_HOST=127.0.0.1
MIY_WEB_DEV_PORT=4200
COMPOSE_PROJECT_NAME=miy-dev

# Production application service and public smoke target
MIY_APP_BIND_HOST=0.0.0.0
MIY_APP_FORWARDED_ALLOW_IPS=127.0.0.1
MIY_APP_PORT=8000
MIY_APP_PUBLIC_URL=

# Desktop updates
MIY_DESKTOP_UPDATE_LINUX_DIR=.miy-desktop-updates/linux
MIY_DESKTOP_UPDATE_MAC_DIR=.miy-desktop-updates/mac
MIY_DESKTOP_UPDATE_WIN_DIR=.miy-desktop-updates/win
VITE_MIY_DESKTOP_INSTALLER_URL_LINUX=/api/v1/miy-desktop/updates/linux/MIY-Desktop-latest.deb
VITE_MIY_DESKTOP_INSTALLER_URL_MAC=/api/v1/miy-desktop/updates/mac/MIY-Desktop-latest.dmg
VITE_MIY_DESKTOP_INSTALLER_URL_WIN=/api/v1/miy-desktop/updates/win/MIY-Desktop-Setup-latest.exe

# Infrastructure containers and published ports
MIY_INFRA_BIND_HOST=127.0.0.1
MIY_INFRA_CONTAINER_PREFIX=miy-dev
MIY_INFRA_MINIO_CONSOLE_PORT=59011
MIY_INFRA_MINIO_PORT=59010
MIY_INFRA_MINIO_ROOT_PASSWORD=miy_dev_minio
MIY_INFRA_MINIO_ROOT_USER=miy_dev_minio
MIY_INFRA_NGINX_PORT=14200
MIY_INFRA_OPENSEARCH_PERF_PORT=59610
MIY_INFRA_OPENSEARCH_PORT=59210
MIY_INFRA_POSTGRES_DB=miy_dev
MIY_INFRA_POSTGRES_PASSWORD=miy_dev
MIY_INFRA_POSTGRES_PORT=55433
MIY_INFRA_POSTGRES_USER=miy_dev
MIY_INFRA_QDRANT_API_KEY=miy_dev_qdrant
MIY_INFRA_QDRANT_GRPC_PORT=16334
MIY_INFRA_QDRANT_PORT=16333
MIY_INFRA_REDIS_PORT=56380
MIY_INFRA_USE_LOCAL_MINIO=auto
MIY_INFRA_USE_LOCAL_POSTGRES=auto

# Application datastores, queues, and search services
# Development Redis overrides; empty values use the configured infra port.
MIY_DEV_REDIS_URL=
MIY_DEV_REDIS_RESULT_BACKEND=
MIY_KEYWORD_SEARCH_BACKEND=opensearch
MIY_MINIO_ACCESS_KEY=miy_dev_minio
MIY_MINIO_BUCKET=miy-dev
MIY_MINIO_ENDPOINT=http://127.0.0.1:59010
MIY_MINIO_SECRET_KEY=miy_dev_minio
MIY_OPENSEARCH_INDEX_PREFIX=miy-dev
MIY_OPENSEARCH_URL=http://127.0.0.1:59210
MIY_POSTGRES_DSN=postgresql+psycopg://miy_dev:miy_dev@127.0.0.1:55433/miy_dev
MIY_WORKER_BROKER_URL=redis://127.0.0.1:56380/0
MIY_WORKER_QUEUE_GROUP=all
MIY_WORKER_RESULT_BACKEND=redis://127.0.0.1:56380/1

# Draw.io service
MIY_DRAWIO_BIND_HOST=0.0.0.0
MIY_DRAWIO_IMAGE_TAG=30.2.5
MIY_DRAWIO_PORT=18082
MIY_DRAWIO_SERVER_URL=

# bento/slides self-hosted service
MIY_BENTO_BIND_HOST=127.0.0.1
MIY_BENTO_IMAGE_TAG=1.0.17
MIY_BENTO_PORT=18084
MIY_BENTO_SERVER_URL=http://127.0.0.1:18084/

# LLM providers
# Exact trusted local inference hosts; adding a connection cannot widen this list.
MIY_LLM_LOCAL_ALLOWED_HOSTS=127.0.0.1,localhost,::1,host.docker.internal
MIY_LLM_EXTERNAL_ALLOWED_PROVIDERS=openai,anthropic,gemini
MIY_LLM_HEALTHCHECK_ON_STARTUP=true
MIY_LLM_REQUIRED=true
HF_TOKEN=

# AI runtime, policy, and agent execution
MIY_AI_ALLOWED_EXTERNAL_PROVIDERS=openai,anthropic,gemini,kipris
MIY_AI_DEFAULT_EXTERNAL_SEARCH_PROVIDER=openai
MIY_AI_EXTERNAL_LLM_ENABLED=false
MIY_AI_EXTERNAL_PLANNER_EXECUTION_ADAPTER=mock
MIY_AI_EXTERNAL_PLANNER_EXECUTION_ENABLED=false
MIY_AI_EXTERNAL_PLANNING_ENABLED=false
MIY_AI_EXTERNAL_QUALITY_REVIEW_ENABLED=false
MIY_AI_EXTERNAL_REASONING_ENABLED=false
MIY_AI_EXTERNAL_SEARCH_ENABLED=false
MIY_AI_EXTERNAL_SEARCH_EXECUTION_ADAPTER=mock
MIY_AI_EXTERNAL_SEARCH_EXECUTION_ENABLED=false
MIY_AI_LOCAL_TOOL_CALLING_ENABLED=false
MIY_AI_MCP_BRIDGE_ENABLED=false
MIY_AI_MODEL_CREDENTIAL_ENCRYPTION_KEY=
MIY_PLATFORM_API_KEY_ENCRYPTION_KEY=
MIY_AI_RUNTIME_GRAPH_ENABLED=false
MIY_AI_RUNTIME_GRAPH_EXECUTION_ENABLED=false
MIY_AI_RUNTIME_SHADOW_WRITE_ENABLED=true
MIY_AI_TOOL_CALLING_ENABLED=true
MIY_AI_WRITE_TOOLS_ENABLED=false

# Open Privacy Filter
MIY_OPF_CACHE_DIR=.runtime/opf-cache
MIY_OPF_CHECKPOINT=openai/privacy-filter
MIY_OPF_DEVICE=cpu
MIY_OPF_DOWNLOAD_ON_STARTUP=true
MIY_OPF_ENABLED=true
MIY_OPF_HEALTHCHECK_ON_STARTUP=true
MIY_OPF_MAX_CONCURRENCY=1
MIY_OPF_MAX_INPUT_CHARS=50000
MIY_OPF_REQUIRED=true
MIY_OPF_SERVICE_BASE_URL=http://127.0.0.1:18081
MIY_OPF_SERVICE_TIMEOUT_MS=10000
MIY_OPF_TIMEOUT_MS=10000

# Inference Gateway client and model diagnostics
MIY_INFERENCE_GATEWAY_API_KEY=local
MIY_INFERENCE_GATEWAY_BASE_URL=http://127.0.0.1:18080
MIY_MODEL_STATUS_DIAGNOSTIC_TARGETS_JSON='[{"id":"local-model-a","display_name":"Local Model A","endpoint_url":"http://127.0.0.1:8000/v1","provider_id":"local","role":"redundancy"},{"id":"local-model-b","display_name":"Local Model B","endpoint_url":"http://127.0.0.1:8001/v1","provider_id":"local","role":"redundancy"}]'

# Retrieval, RAG, OCR, embeddings, and reranking
MIY_FILES_RETRIEVAL_ENABLED=false
MIY_RAG_DOCLING_FORCE_OCR=false
MIY_RAG_DOCLING_MIN_TEXT_CHARS=128
MIY_RAG_DOCLING_OCR_ENGINE=easyocr
MIY_RAG_DOCLING_OCR_LANGS=ko,en
MIY_RAG_EMBEDDING_DEVICE=auto
MIY_RAG_EMBEDDING_DTYPE=bfloat16
MIY_RAG_EMBEDDING_NORMALIZE=true
MIY_RAG_EMBEDDING_PROVIDER=inference_gateway
MIY_RAG_EMBEDDING_QUERY_PREFIX=
MIY_RAG_EMBEDDING_QUERY_PROMPT_NAME=query
MIY_RAG_EMBEDDING_TRUST_REMOTE_CODE=false
MIY_RAG_ENABLED=true
MIY_RAG_FAIL_STARTUP_ON_PRELOAD_ERROR=false
MIY_RAG_OCR_PROVIDER=inference_gateway
MIY_RAG_PRELOAD_ON_STARTUP=true
MIY_RAG_QDRANT_API_KEY=miy_dev_qdrant
MIY_RAG_QDRANT_COLLECTION_PREFIX=miy-dev-rag
MIY_RAG_QDRANT_URL=http://127.0.0.1:16333
MIY_RAG_RERANK_PROVIDER=inference_gateway
MIY_RAG_RERANKER_DEVICE=auto
MIY_RAG_RERANKER_DTYPE=bfloat16
MIY_RAG_RERANKER_TRUST_REMOTE_CODE=false
MIY_RAG_VECTOR_INDEX_PROVIDER=qdrant
MIY_RAG_VISION_OCR_DPI=160
MIY_RAG_VISION_OCR_ENABLED=true
MIY_RAG_VISION_OCR_MAX_NEW_TOKENS=1024
MIY_RAG_VISION_OCR_MAX_PAGES=2
MIY_RAG_VISION_OCR_TIMEOUT_SECONDS=600
MIY_RETRIEVAL_UNIFIED_ENABLED=true

# Speech recognition
MIY_API_ASR_BACKEND=inference_gateway
MIY_API_ASR_COHERE_BASE_URL=https://api.cohere.com/v2
MIY_API_ASR_COHERE_MODEL=transcribe-v1
MIY_API_ASR_INFERENCE_GATEWAY_MODEL=transcribe-v1
MIY_API_ASR_QWEN_DEVICE=cuda
MIY_API_ASR_QWEN_MODEL=Qwen/Qwen3-ASR-1.7B
MIY_API_ASR_WHISPER_COMPUTE_TYPE=float16
MIY_API_ASR_WHISPER_DEVICE=cuda
MIY_API_ASR_WHISPER_MODEL=large-v3
MIY_API_COHERE_API_KEY=

# Collaboration and realtime
MIY_API_COLLAB_REDIS_URL=redis://127.0.0.1:56380/0
MIY_API_REALTIME_REDIS_URL=redis://127.0.0.1:56380/0

# Platform-admin Codex terminal (requires tmux; disabled unless explicitly enabled)
MIY_API_AGENT_TERMINAL_ALLOWED_ROOTS='{"miy":"."}'
MIY_API_AGENT_TERMINAL_CODEX_BIN=codex
MIY_CODEX_CONSOLE_LAUNCH_URL=
MIY_CODEX_CONSOLE_LAUNCH_URL_BY_HOST='{}'
MIY_CODEX_CONSOLE_REGISTRATION_AUDIENCES='[]'
MIY_API_AGENT_TERMINAL_ENABLED=false
MIY_API_AGENT_TERMINAL_MAX_SESSIONS_PER_USER=4
MIY_API_AGENT_TERMINAL_MAX_SESSIONS_TOTAL=20
MIY_API_AGENT_TERMINAL_REPLAY_BUFFER_BYTES=262144
MIY_API_AGENT_TERMINAL_TMUX_BIN=tmux

# Recording, video chat, and LiveKit
MIY_API_RECORDING_SPOOL_DIR=.dev/recording-spool
MIY_API_VIDEO_CHAT_ENABLED=true
MIY_LIVEKIT_API_KEY=devkey
MIY_LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-0001
MIY_LIVEKIT_EGRESS_API_URL=
MIY_LIVEKIT_PORT=7880
MIY_LIVEKIT_PUBLIC_URL=
MIY_LIVEKIT_RTC_PORT_RANGE_END=52100
MIY_LIVEKIT_RTC_PORT_RANGE_START=52000
MIY_LIVEKIT_RTC_TCP_PORT=7881
MIY_LIVEKIT_URL=ws://127.0.0.1:7880
MIY_VIDEO_CHAT_CAPTIONS_ENABLED=false
MIY_VIDEO_CHAT_RECORDING_ENABLED=false
MIY_VIDEO_CHAT_ROOM_PREFIX=miy
MIY_VIDEO_CHAT_TOKEN_TTL_SECONDS=3600

# Authenticated content and personal communications
MIY_CONTENT_GRANT_SIGNING_KEY=dev-content-grant-signing-key
MIY_MAIL_ALLOW_INSECURE_TRANSPORT=false
MIY_MAIL_ALLOWED_PRIVATE_HOSTS=
MIY_MAIL_CREDENTIAL_ENCRYPTION_KEY=

# Observability
MIY_OTEL_CONSOLE_EXPORTER=false
MIY_OTEL_ENABLED=true
MIY_OTEL_OTLP_EXPORTER_ENABLED=false

# Hermes autonomous agent control plane
MIY_HERMES_ENABLED=false
MIY_HERMES_RUNTIME_PORT=18642
MIY_HERMES_MANAGEMENT_PORT=19119
MIY_HERMES_RUNTIME_BASE_URL=http://127.0.0.1:18642
MIY_HERMES_MANAGEMENT_BASE_URL=http://127.0.0.1:19119
MIY_HERMES_API_KEY=miy-dev-hermes-runtime-key-0001
MIY_HERMES_MANAGEMENT_TOKEN=miy-dev-hermes-management-token-0001
MIY_HERMES_MCP_SERVER_URL=http://127.0.0.1:8001/api/v1/internal/hermes/mcp
MIY_HERMES_MCP_SHARED_SECRET=miy-dev-hermes-mcp-shared-secret-0000000000000001
MIY_HERMES_PROFILE_CLONE_SOURCE=default
MIY_HERMES_REQUEST_TIMEOUT_SECONDS=30
MIY_HERMES_RUN_TIMEOUT_SECONDS=3600
MIY_HERMES_MAX_CONCURRENT_RUNS=10
MIY_HERMES_DOCKER_GID=0
MIY_HERMES_DISPATCH_LEASE_SECONDS=300
MIY_HERMES_TERMINAL_BROKER_PORT=18765
MIY_HERMES_TERMINAL_BROKER_BASE_URL=http://127.0.0.1:18765
MIY_HERMES_TERMINAL_RESOURCE_NAMESPACE=dev
MIY_HERMES_TERMINAL_MCP_RELAY_URL=http://hermes-terminal-broker:18765/mcp
MIY_HERMES_TERMINAL_MCP_SOCKET_PATH=.runtime/hermes-terminal-mcp.sock
MIY_HERMES_TERMINAL_MAX_SESSIONS_PER_WORKSPACE_USER=1
MIY_HERMES_TERMINAL_MAX_SESSIONS_PER_USER=2
MIY_HERMES_TERMINAL_MAX_SESSIONS_TOTAL=20
MIY_HERMES_TERMINAL_IDLE_TIMEOUT_SECONDS=7200
MIY_HERMES_TERMINAL_ARTIFACT_RETENTION_DAYS=30
MIY_HERMES_TERMINAL_APPROVAL_TIMEOUT_SECONDS=300
MIY_HERMES_TERMINAL_PROFILE_ARCHIVE_MAX_BYTES=67108864
MIY_HERMES_TERMINAL_WORKSPACE_ARCHIVE_MAX_BYTES=268435456
