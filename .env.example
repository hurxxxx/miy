MTY_LLM_LOCAL_LONG_GENERATION_TIMEOUT_SECONDS=1200
MTY_LLM_LOCAL_PROVIDER=docker-model-runner
MTY_LLM_REQUEST_TIMEOUT_SECONDS=60
MTY_LLM_REQUIRED=true
HF_TOKEN=

# AI runtime, policy, and agent execution
MTY_AI_AGENT_MAX_CONSECUTIVE_TOOL_ERRORS=3
MTY_AI_AGENT_MAX_TOOL_CALLS=16
MTY_AI_AGENT_MAX_TURNS=8
MTY_AI_ALLOWED_EXTERNAL_PROVIDERS=openai,anthropic,gemini,kipris
MTY_AI_CONVERSATION_RUN_LOCK_TTL_SECONDS=1800
MTY_AI_DEFAULT_EXTERNAL_LLM_PROVIDER=openai
MTY_AI_DEFAULT_EXTERNAL_SEARCH_PROVIDER=openai
MTY_AI_EXTERNAL_LLM_ENABLED=false
MTY_AI_EXTERNAL_PLANNER_EXECUTION_ADAPTER=mock
MTY_AI_EXTERNAL_PLANNER_EXECUTION_ENABLED=false
MTY_AI_EXTERNAL_PLANNING_ENABLED=false
MTY_AI_EXTERNAL_QUALITY_REVIEW_ENABLED=false
MTY_AI_EXTERNAL_REASONING_ENABLED=false
MTY_AI_EXTERNAL_SEARCH_ENABLED=false
MTY_AI_EXTERNAL_SEARCH_EXECUTION_ADAPTER=mock
MTY_AI_EXTERNAL_SEARCH_EXECUTION_ENABLED=false
MTY_AI_LOCAL_TOOL_CALLING_ENABLED=false
MTY_AI_MCP_BRIDGE_ENABLED=false
MTY_AI_MODEL_CREDENTIAL_ENCRYPTION_KEY=
MTY_PLATFORM_API_KEY_ENCRYPTION_KEY=
MTY_AI_RUNTIME_GRAPH_ENABLED=false
MTY_AI_RUNTIME_GRAPH_EXECUTION_ENABLED=false
MTY_AI_RUNTIME_RETENTION_DAYS=90
MTY_AI_RUNTIME_SHADOW_WRITE_ENABLED=true
MTY_AI_RUNTIME_TRACE_PAYLOAD_MAX_BYTES=32768
MTY_AI_TOOL_CALLING_ENABLED=true
MTY_AI_WRITE_TOOLS_ENABLED=false

# Open Privacy Filter
MTY_OPF_CACHE_DIR=.runtime/opf-cache
MTY_OPF_CHECKPOINT=openai/privacy-filter
MTY_OPF_DEVICE=cpu
MTY_OPF_DOWNLOAD_ON_STARTUP=true
MTY_OPF_ENABLED=true
MTY_OPF_HEALTHCHECK_ON_STARTUP=true
MTY_OPF_MAX_CONCURRENCY=1
MTY_OPF_MAX_INPUT_CHARS=50000
MTY_OPF_REQUIRED=true
MTY_OPF_SERVICE_BASE_URL=http://127.0.0.1:18081
MTY_OPF_SERVICE_TIMEOUT_MS=10000
MTY_OPF_TIMEOUT_MS=10000

# Inference Gateway client and model diagnostics
MTY_INFERENCE_GATEWAY_API_KEY=local
MTY_INFERENCE_GATEWAY_BASE_URL=http://127.0.0.1:18080
MTY_MODEL_STATUS_DIAGNOSTIC_TARGETS_JSON='[{"id":"local-model-a","display_name":"Local Model A","endpoint_url":"http://127.0.0.1:8000/v1","provider_id":"local","role":"redundancy"},{"id":"local-model-b","display_name":"Local Model B","endpoint_url":"http://127.0.0.1:8001/v1","provider_id":"local","role":"redundancy"}]'
MTY_MODEL_STATUS_REQUEST_TIMEOUT_SECONDS=5

