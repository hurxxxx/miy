# MTY environment
# Canonical env contract. Keep dev/prod/local/example keysets and order identical.
# Values may differ by environment; do not print secrets in logs.

# Runtime identity, API entrypoint, and web development
MTY_API_ALLOW_DEV_ADMIN_LOGIN=1
MTY_API_APP_NAME=MTY API
MTY_API_DEV_LOGIN_ALLOWED_HOSTS=
MTY_API_DEV_LOGIN_PASSWORD=mty-dev-only
MTY_API_DEV_PORT=8001
MTY_API_ENVIRONMENT=development
MTY_API_FRONTEND_DIST_DIR=
MTY_API_INSTANCE_ID=dev-api
MTY_API_OBJECT_STORAGE_REQUIRED=true
MTY_API_PREFIX=/api/v1
MTY_API_SEED_DEV_LOGIN_ACCOUNT=true
MTY_API_SERVE_FRONTEND=false
MTY_API_SESSION_TTL_HOURS=168
MTY_ENV_PROFILE=dev
MTY_WEB_API_PROXY_TARGET=http://127.0.0.1:8001
MTY_WEB_DEV_ALLOWED_HOSTS=
MTY_UAT_BASE_URL=
MTY_WEB_DEV_HOST=127.0.0.1
MTY_WEB_DEV_PORT=4200
COMPOSE_PROJECT_NAME=mty-dev

# Production application service and public smoke target
MTY_APP_BIND_HOST=0.0.0.0
MTY_APP_FORWARDED_ALLOW_IPS=127.0.0.1
MTY_APP_PORT=8000
MTY_APP_PUBLIC_URL=

# Desktop updates
MTY_DESKTOP_UPDATE_LINUX_DIR=.mty-desktop-updates/linux
MTY_DESKTOP_UPDATE_MAC_DIR=.mty-desktop-updates/mac
MTY_DESKTOP_UPDATE_WIN_DIR=.mty-desktop-updates/win
VITE_MTY_DESKTOP_INSTALLER_URL_LINUX=/api/v1/mty-desktop/updates/linux/MTY-Desktop-latest.deb
VITE_MTY_DESKTOP_INSTALLER_URL_MAC=/api/v1/mty-desktop/updates/mac/MTY-Desktop-latest.dmg
VITE_MTY_DESKTOP_INSTALLER_URL_WIN=/api/v1/mty-desktop/updates/win/MTY-Desktop-Setup-latest.exe

# Infrastructure containers and published ports
MTY_INFRA_BIND_HOST=127.0.0.1
MTY_INFRA_CONTAINER_PREFIX=mty-dev
MTY_INFRA_MINIO_CONSOLE_PORT=59011
MTY_INFRA_MINIO_PORT=59010
MTY_INFRA_MINIO_ROOT_PASSWORD=mty_dev_minio
MTY_INFRA_MINIO_ROOT_USER=mty_dev_minio
MTY_INFRA_NGINX_PORT=14200
MTY_INFRA_OPENSEARCH_PERF_PORT=59610
MTY_INFRA_OPENSEARCH_PORT=59210
MTY_INFRA_POSTGRES_DB=mty_dev
MTY_INFRA_POSTGRES_PASSWORD=mty_dev
MTY_INFRA_POSTGRES_PORT=55433
MTY_INFRA_POSTGRES_USER=mty_dev
MTY_INFRA_QDRANT_API_KEY=mty_dev_qdrant
MTY_INFRA_QDRANT_GRPC_PORT=16334
MTY_INFRA_QDRANT_PORT=16333
MTY_INFRA_REDIS_PORT=56380
MTY_INFRA_USE_LOCAL_MINIO=auto
MTY_INFRA_USE_LOCAL_POSTGRES=auto

# Application datastores, queues, and search services
# Development Redis overrides; empty values use the configured infra port.
MTY_DEV_REDIS_URL=
MTY_DEV_REDIS_RESULT_BACKEND=
MTY_KEYWORD_SEARCH_BACKEND=opensearch
MTY_MINIO_ACCESS_KEY=mty_dev_minio
MTY_MINIO_BUCKET=mty-dev
MTY_MINIO_ENDPOINT=http://127.0.0.1:59010
MTY_MINIO_SECRET_KEY=mty_dev_minio
MTY_OPENSEARCH_INDEX_PREFIX=mty-dev
MTY_OPENSEARCH_URL=http://127.0.0.1:59210
MTY_POSTGRES_DSN=postgresql+psycopg://mty_dev:mty_dev@127.0.0.1:55433/mty_dev
MTY_WORKER_BROKER_URL=redis://127.0.0.1:56380/0
MTY_WORKER_QUEUE_GROUP=all
MTY_WORKER_RESULT_BACKEND=redis://127.0.0.1:56380/1

# Draw.io service
MTY_DRAWIO_BIND_HOST=0.0.0.0
MTY_DRAWIO_IMAGE_TAG=30.2.5
MTY_DRAWIO_PORT=18082
MTY_DRAWIO_SERVER_URL=

# bento/slides self-hosted service
MTY_BENTO_BIND_HOST=127.0.0.1
MTY_BENTO_IMAGE_TAG=1.0.17
MTY_BENTO_PORT=18084
MTY_BENTO_SERVER_URL=http://127.0.0.1:18084/

# LLM providers
MTY_LLM_EXTERNAL_ALLOWED_PROVIDERS=openai,anthropic,gemini
MTY_LLM_EXTERNAL_LONG_GENERATION_TIMEOUT_SECONDS=900
MTY_LLM_HEALTHCHECK_ON_STARTUP=true
