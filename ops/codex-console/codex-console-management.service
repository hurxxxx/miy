[Unit]
Description=Private Codex management UI and read-only monitoring
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/mty-codex-console/current/apps/codex-console-api
EnvironmentFile=%h/.config/mty-codex-console/console.env
ExecStart=%h/.local/share/mty-codex-console/current/apps/codex-console-api/.venv/bin/codex-console manage
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
