[Unit]
Description=Private Codex template sessions with a separately pinned release
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/mty-codex-console/template-current/apps/codex-console-api
EnvironmentFile=%h/.config/mty-codex-console/console.env
ExecStart=%h/.local/share/mty-codex-console/template-current/apps/codex-console-api/.venv/bin/codex-console templates
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=false

[Install]
WantedBy=default.target
