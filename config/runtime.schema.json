{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "miy public runtime defaults",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "defaults",
    "profiles"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "defaults": {
      "$ref": "#/$defs/settings",
      "required": [
        "MIY_LLM_EXTERNAL_LONG_GENERATION_TIMEOUT_SECONDS",
        "MIY_LLM_LOCAL_LONG_GENERATION_TIMEOUT_SECONDS",
        "MIY_LLM_REQUEST_TIMEOUT_SECONDS",
        "MIY_AI_AGENT_MAX_CONSECUTIVE_TOOL_ERRORS",
        "MIY_AI_AGENT_MAX_TOOL_CALLS",
        "MIY_AI_AGENT_MAX_TURNS",
        "MIY_AI_CONVERSATION_RUN_LOCK_TTL_SECONDS",
        "MIY_AI_RUNTIME_RETENTION_DAYS",
        "MIY_AI_RUNTIME_TRACE_PAYLOAD_MAX_BYTES",
        "MIY_MODEL_STATUS_REQUEST_TIMEOUT_SECONDS",
        "MIY_RAG_BACKFILL_BATCH_SIZE",
        "MIY_RAG_BACKFILL_THROTTLE_MS",
        "MIY_RAG_EMBEDDING_BATCH_SIZE",
        "MIY_RAG_EMBEDDING_MAX_SEQ_LENGTH",
        "MIY_RAG_EMBEDDING_MODEL",
        "MIY_RAG_EMBEDDING_REVISION",
