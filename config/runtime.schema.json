        "MIY_RAG_EMBEDDING_BATCH_SIZE": {
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "MIY_RAG_EMBEDDING_MAX_SEQ_LENGTH": {
          "maximum": 8192,
          "minimum": 128,
          "type": "integer"
        },
        "MIY_RAG_RERANKER_MODEL": {
          "type": "string"
        },
        "MIY_RAG_RERANKER_REVISION": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "MIY_RAG_RERANKER_BATCH_SIZE": {
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "MIY_RAG_RERANKER_MAX_LENGTH": {
          "maximum": 8192,
          "minimum": 128,
          "type": "integer"
        },
        "MIY_OTEL_METRICS_EXPORT_INTERVAL_MS": {
          "maximum": 300000,
          "minimum": 1000,
          "type": "integer"
        },
        "MIY_API_EVENT_LOOP_LAG_WARN_MS": {
          "maximum": 60000,
          "minimum": 100,
          "type": "integer"
        },
        "MIY_API_EVENT_LOOP_LAG_INTERVAL_SECONDS": {
          "maximum": 60,
          "minimum": 0.1,
          "type": "number"
        },
        "MIY_WORKER_DB_POOL_SIZE": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "MIY_WORKER_DB_MAX_OVERFLOW": {
          "maximum": 100,
          "minimum": 0,
