        "MIY_AI_AGENT_MAX_TOOL_CALLS": {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "MIY_AI_AGENT_MAX_CONSECUTIVE_TOOL_ERRORS": {
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        },
        "MIY_RAG_QUERY_TIMEOUT_MS": {
          "maximum": 600000,
          "minimum": 100,
          "type": "integer"
        },
        "MIY_RAG_RERANK_CANDIDATE_K": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "MIY_RAG_JOB_PROCESSING_LEASE_SECONDS": {
          "maximum": 7200,
          "minimum": 60,
          "type": "integer"
        },
        "MIY_RAG_EMBEDDING_MODEL": {
          "type": "string"
        },
        "MIY_RAG_EMBEDDING_REVISION": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
