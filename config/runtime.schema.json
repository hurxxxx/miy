          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "MIY_API_COLLAB_CLEANUP_TIMEOUT_SECONDS": {
          "maximum": 60,
          "minimum": 0.1,
          "type": "number"
        },
        "MIY_API_DB_POOL_SIZE": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "MIY_API_DB_MAX_OVERFLOW": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "MIY_API_DB_POOL_TIMEOUT": {
          "maximum": 300,
          "minimum": 1,
          "type": "integer"
        },
