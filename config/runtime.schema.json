    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "dev", "prod", "preview", "test"],
      "properties": {
        "local": {
          "$ref": "#/$defs/settings"
        },
        "dev": {
          "$ref": "#/$defs/settings"
        },
        "prod": {
          "$ref": "#/$defs/settings"
        },
        "preview": {
          "$ref": "#/$defs/settings"
        },
        "test": {
          "$ref": "#/$defs/settings"
        }
      }
    }
  },
