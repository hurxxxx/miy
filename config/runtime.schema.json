          "minimum": 60,
          "type": "integer"
        },
        "MIY_AI_RUNTIME_TRACE_PAYLOAD_MAX_BYTES": {
          "maximum": 1048576,
          "minimum": 1024,
          "type": "integer"
        },
        "MIY_AI_RUNTIME_RETENTION_DAYS": {
          "maximum": 3650,
          "minimum": 1,
          "type": "integer"
