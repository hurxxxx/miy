          "minimum": 1048576,
          "type": "integer"
        },
        "MIY_API_RECORDING_STAGING_RETENTION_HOURS": {
          "maximum": 720,
          "minimum": 1,
          "type": "integer"
        },
        "MIY_API_ASR_REQUEST_TIMEOUT_SECONDS": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "type": "number"
        },
        "MIY_MODEL_STATUS_REQUEST_TIMEOUT_SECONDS": {
          "exclusiveMinimum": 0,
          "maximum": 30,
          "type": "number"
        },
        "MIY_LLM_LOCAL_LONG_GENERATION_TIMEOUT_SECONDS": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "type": "number"
        },
        "MIY_LLM_EXTERNAL_LONG_GENERATION_TIMEOUT_SECONDS": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "type": "number"
        },
        "MIY_LLM_REQUEST_TIMEOUT_SECONDS": {
