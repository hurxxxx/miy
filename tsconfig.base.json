{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@mty/contracts": ["./packages/contracts/src/index.ts"],
      "@mty/contracts/openapi": [
        "./packages/contracts/src/openapi.generated.d.ts"
      ],
      "@mty/contracts/*": ["./packages/contracts/src/*"],
      "@mty/core-web": ["./packages/core-web/src/index.ts"],
      "@mty/core-web/*": ["./packages/core-web/src/*"],
      "@mty/web-shell": ["./apps/web/src/app/shell/AppContent.tsx"],
      "@mty/web/styles.css": ["./apps/web/src/index.css"],
      "@mty/web/fullcalendar-theme.css": [
        "./apps/web/src/styles/fullcalendar-theme.css"
      ],
      "@mty/ui": ["./packages/ui/src/index.ts"],
      "@mty/ui/*": ["./packages/ui/src/lib/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
