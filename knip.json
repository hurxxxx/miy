{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": ["coverage/**", "dist/**", "node_modules/**"],
  "rules": {
    "dependencies": "off",
    "devDependencies": "off",
    "unlisted": "off"
  },
  "workspaces": {
    ".": {
      "entry": [
        "apps/web/src/main.tsx",
        "apps/web/src/App.tsx",
        "apps/web/src/app/AppRoot.tsx",
        "apps/web/vite.config.mts",
        "apps/web/playwright.config.ts",
        "packages/ui/src/index.ts",
        "packages/ui/styles.css",
        "packages/ui/vite.config.mts",
        "eslint.config.mjs",
        "scripts/blocknote-collab-codec.mjs",
        "scripts/check-path-hardcoding.mjs",
        "scripts/check-path-hardcoding.test.mjs",
        "scripts/check-contracts-publish-tag.mjs",
        "scripts/check-web-app-boundaries.mjs",
        "scripts/check-web-app-boundaries.test.mjs",
        "scripts/check-official-suite-ownership.mjs",
        "scripts/dev-login-browser-smoke.mjs",
        "scripts/web-i18n-message-checker.test.mjs",
        "packages/official-suite-web/src/index.ts",
        "packages/platform-web/src/index.ts"
      ],
      "paths": {
        "@/src/*": ["apps/web/src/*"],
        "@miy/ui": ["packages/ui/src/index.ts"],
        "@miy/ui/styles.css": ["packages/ui/styles.css"],
        "@miy/web-shell": ["apps/web/src/app/shell/AppContent.tsx"],
        "@miy/web/styles.css": ["apps/web/src/index.css"],
        "@miy/web/fullcalendar-theme.css": [
          "apps/web/src/styles/fullcalendar-theme.css"
        ]
      },
      "project": ["*.cjs", "*.mjs", "scripts/**/*.mjs"]
    },
    "apps/web": {
      "entry": [
        "src/main.tsx",
        "src/App.tsx",
        "src/app/AppRoot.tsx",
        "vite.config.mts",
        "playwright.config.ts"
      ],
      "ignore": [
        "src/**/*.spec.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "src/test-setup.ts",
        "tests/**"
      ],
      "paths": {
        "@/src/*": ["src/*"],
        "@miy/ui": ["../../packages/ui/src/index.ts"],
        "@miy/ui/styles.css": ["../../packages/ui/styles.css"],
        "@miy/web-shell": ["../web/src/app/shell/AppContent.tsx"],
        "@miy/web/styles.css": ["../web/src/index.css"],
        "@miy/web/fullcalendar-theme.css": [
          "../web/src/styles/fullcalendar-theme.css"
        ]
      },
      "project": [
        "*.config.{ts,mts}",
        "playwright.config.ts",
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "vite.config.mts"
      ]
    },
    "apps/official-suite": {
      "entry": ["src/main.tsx", "vite.config.mts"],
      "ignore": ["src/**/*.spec.{ts,tsx}"],
      "paths": {
        "@/src/*": ["../web/src/*"]
      },
      "project": ["src/**/*.{ts,tsx}", "vite.config.mts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "styles.css"],
      "project": ["src/**/*.{ts,tsx}", "styles.css"]
    }
  }
}
